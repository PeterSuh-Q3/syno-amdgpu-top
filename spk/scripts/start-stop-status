#!/bin/sh
# DSM requires this compatibility entry point even for a file-only package.
# status must return success so DSM does not repeatedly stop/restart an
# intentionally daemonless package (same convention as syno-amdgpu-runtime /
# SynoCommunity's SynoCli Video Drivers package).
case "${1:-}" in
  start)
    # Ensure the /usr/bin/amdgpu_top shim exists. On some DSM units postinst
    # runs before the helper's setuid bit is applied, so retry idempotently.
    RUNTIME=/var/packages/syno-amdgpu-top/target
    for node in /dev/dri/renderD*; do
      [ -c "$node" ] || continue
      [ "$(cat "/sys/class/drm/${node##*/}/device/vendor" 2>/dev/null || true)" = "0x1002" ] || continue
      [ -x "$RUNTIME/bin/helper/amdgpu-path-helper" ] && "$RUNTIME/bin/helper/amdgpu-path-helper" install || true
      break
    done
    exit 0
    ;;
  status) exit 0 ;;
  stop) exit 0 ;;
  log) exit 1 ;;
  *) exit 1 ;;
esac
