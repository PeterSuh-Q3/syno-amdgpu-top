package="syno-amdgpu-top"
version="0.1.1"
displayname="Synology AMDGPU Top"
description="Standalone amdgpu_top GPU monitor for DSM (no Mesa/VA-API runtime)."
arch="epyc7002"
os_min_ver="7.4-00000"
maintainer="PeterSuh-Q3"
maintainer_url="https://github.com/PeterSuh-Q3/syno-amdgpu-top"
distributor="PeterSuh-Q3"
distributor_url="https://github.com/PeterSuh-Q3/syno-amdgpu-top"
support_url="https://github.com/PeterSuh-Q3/syno-amdgpu-top/issues"
thirdparty="yes"
beta="false"
# DSM 7.4 needs both flags for a daemonless runtime: startable prevents a
# Start action from being offered, while ctl_stop removes service controls.
startable="no"
ctl_stop="no"
ctl_uninstall="yes"
support_conf_folder="yes"
install_dep_packages=""
